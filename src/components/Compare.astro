---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  label: string;
}
const { project, label } = Astro.props;
const id = `cmp-${project.slug}`;
---

<div class="compare" data-compare>
  <p class="title" id={`${id}-t`}>{label}</p>
  <div class="tabs" role="group" aria-labelledby={`${id}-t`} hidden data-tabs>
    {
      project.compare.map((c, i) => (
        <button type="button" class="tab" aria-pressed={i === 0 ? 'true' : 'false'} data-tab={i}>
          {c.label}
        </button>
      ))
    }
  </div>
  {
    project.compare.map((c, i) => {
      const max = Math.max(c.mine.value, c.base.value);
      return (
        <figure class="pair" data-pair={i} aria-label={`${c.label}: ${c.mine.name} ${c.mine.text}, ${c.base.name} ${c.base.text}`}>
          <figcaption class="pair-label">{c.label}</figcaption>
          <div class="row mine">
            <span class="who">{c.mine.name}</span>
            <span class="val num">{c.mine.text}</span>
            <span class="track" aria-hidden="true">
              <span class="fill" style={`--s:${(c.mine.value / max).toFixed(3)}`} />
            </span>
          </div>
          <div class="row base">
            <span class="who">{c.base.name}</span>
            <span class:list={['val num', { word: !/\d/.test(c.base.text) }]}>{c.base.text}</span>
            <span class="track" aria-hidden="true">
              <span class="fill" style={`--s:${(c.base.value / max).toFixed(3)}`} />
            </span>
          </div>
        </figure>
      );
    })
  }
</div>

<style>
  .compare {
    display: grid;
    gap: 14px;
  }
  .title {
    font-weight: 600;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tabs[hidden] {
    display: none;
  }
  .tab {
    min-height: 44px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: var(--surface-2);
    font-size: var(--step-small);
    cursor: pointer;
    transition: background-color var(--t-hover) ease, color var(--t-hover) ease, transform var(--t-press) var(--ease-out);
  }
  .tab:hover {
    background: color-mix(in srgb, var(--ink) 14%, var(--surface-2));
  }
  .tab:active {
    transform: scale(0.96);
  }
  .tab[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
  }
  .pair {
    display: grid;
    gap: 12px;
  }
  .pair[hidden] {
    display: none;
  }
  /* the tabs already name the measure once they exist */
  .compare.live .pair-label {
    position: absolute;
    width: 1px;
    height: 1px; /* taste-skill-ignore: visually hidden text, not a rule */
    overflow: hidden;
    clip-path: inset(50%);
  }
  .pair-label {
    font-size: var(--step-small);
  }
  .row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 16px;
    align-items: baseline;
  }
  .who {
    font-size: var(--step-small);
  }
  .val {
    font-size: var(--step-lead);
    font-weight: 600;
    line-height: 1;
  }
  .base .val {
    color: var(--muted);
  }
  /* a word in place of a figure ("baseline") is read, not compared */
  .val.word {
    font-size: var(--step-body);
    font-weight: 500;
  }
  .track {
    grid-column: 1 / -1;
    height: 12px;
    border-radius: 999px;
    background: var(--surface-2);
    overflow: hidden;
  }
  .fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    transform: scaleX(var(--s));
    transform-origin: left;
    transition: transform 900ms var(--ease-expo);
  }
  .mine .fill {
    background: var(--accent);
  }
  .base .fill {
    background: var(--bar-base);
  }
  /* bars grow from zero each time a pair is shown */
  .pair.grow .fill {
    transform: scaleX(0);
    transition: none;
  }
</style>

<script>
  // The live thing: pick a measure and its two bars redraw from zero.
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((box) => {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const pairs = [...box.querySelectorAll<HTMLElement>('[data-pair]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    box.querySelector<HTMLElement>('[data-tabs]')!.hidden = false;
    box.classList.add('live');

    const show = (n: number) => {
      tabs.forEach((t, i) => t.setAttribute('aria-pressed', String(i === n)));
      pairs.forEach((p, i) => (p.hidden = i !== n));
      if (reduce) return;
      const pair = pairs[n];
      pair.classList.add('grow');
      void pair.offsetWidth; // restart the transition
      requestAnimationFrame(() => pair.classList.remove('grow'));
    };
    const current = () => Math.max(0, tabs.findIndex((t) => t.getAttribute('aria-pressed') === 'true'));
    tabs.forEach((t, i) => t.addEventListener('click', () => show(i)));
    show(0);

    // Redraw when its case comes on the home stage, and once when it first scrolls into view.
    box.closest('[data-case]')?.addEventListener('case:show', () => show(current()));
    new IntersectionObserver(
      (entries, io) => {
        if (entries[0].isIntersecting) {
          show(current());
          io.disconnect();
        }
      },
      { threshold: 0.4 },
    ).observe(box);
  });
</script>
