---
import { figures } from '../data/site';
---

<section class="figures" aria-label="Figures from the three projects">
  <div class="ticker" style="--ticker-speed:46s">
    <div class="ticker-track">
      {
        [0, 1].map((copy) => (
          <ul class="ticker-group" aria-hidden={copy === 1 ? 'true' : undefined}>
            {figures.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  .figures {
    padding-block: 28px;
    background: var(--field);
    color: var(--field-ink);
  }
  li {
    display: flex;
    align-items: center;
    padding-inline: 28px;
    font-size: var(--step-lead);
    font-weight: 500;
    white-space: nowrap;
  }
  /* a filled dot between figures, in the accent */
  li::after {
    content: '';
    width: 8px;
    height: 8px;
    margin-left: 56px;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
