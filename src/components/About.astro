---
import { about, sections, site } from '../data/site';
---

<section id="about" class="about section frame" aria-labelledby="about-title">
  <!-- OPTIONAL PHOTO SLOT: a round portrait (44px) above the letter, only if the owner supplies one. -->
  <div class="letter" data-reveal-group>
    <h2 id="about-title" data-reveal>{sections.about.heading}</h2>
    {about.paragraphs.map((p, i) => <p data-reveal style={`--i:${i + 1}`}>{p}</p>)}
    <p class="sign" data-reveal style="--i:4">
      <span class="name">{site.name}</span>
      <span class="small muted">{site.role}, {site.location}</span>
    </p>
  </div>

  <dl class="notes" data-reveal-group aria-label="Case notes">
    {
      about.notes.map((n, i) => (
        <div data-reveal style={`--i:${i}`}>
          <dt>{n.key}</dt>
          <dd>{n.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .about {
    display: grid;
    gap: 64px;
    align-items: start;
  }
  .letter {
    display: grid;
    gap: 22px;
    max-width: 600px;
  }
  .letter h2 {
    margin-bottom: 8px;
  }
  .sign {
    display: grid;
    gap: 4px;
    margin-top: 12px;
  }
  .name {
    font-style: italic;
    font-size: var(--step-lead);
  }
  .notes {
    display: grid;
    gap: 14px;
    padding: 28px 32px;
    background: var(--surface);
    border-radius: var(--radius);
  }
  .notes div {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
  }
  dt {
    color: var(--muted);
  }
  dt::after {
    content: ':';
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(48px, 8vw, 140px);
    }
    .notes {
      margin-top: calc(var(--step-head) + 30px);
    }
  }
</style>
