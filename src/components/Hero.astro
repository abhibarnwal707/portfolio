---
import { site, hero } from '../data/site';
import Icon from './Icon.astro';
import IsoScene from './IsoScene.astro';
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="copy">
    <p class="label fade-in">{hero.label}</p>
    <h1 id="hero-title">
      {
        hero.title.map((line, i) => (
          <span class="rise">
            <span style={`--i:${i}`}>{line}</span>
          </span>
        ))
      }
    </h1>
    <div class="tag fade-in" style="--i:1">
      <p>{hero.tagline}</p>
      <span class="badge-ring" aria-hidden="true"><Icon name="target" size={26} /></span>
    </div>
    <p class="sub fade-in" style="--i:2">{hero.subline}</p>

    <div class="actions fade-in" style="--i:3">
      <a class="btn" href="#work">
        <span class="btn-strip"><Icon name="play" size={16} /></span>
        <span class="btn-text">{hero.action}</span>
      </a>
      <a class="btn-ghost" href={site.resume} target="_blank" rel="noopener noreferrer">
        Resume <Icon name="download" size={18} />
      </a>
    </div>

    <ul class="metrics" aria-label="Headline metrics">
      {
        hero.metrics.map((m, i) => (
          <li class="fade-in" style={`--i:${4 + i}`}>
            <span class="big-num" data-count={m.value}>
              {m.value}
            </span>
            <span class="m-label">
              {m.label} ({m.project})
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="art fade-in" style="--i:2">
    <IsoScene />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 24px;
    padding-top: clamp(28px, 4vw, 56px);
    padding-bottom: clamp(24px, 3vw, 40px);
  }
  .copy {
    display: grid;
    gap: 22px;
    align-content: center;
  }
  h1 {
    font-size: clamp(4.2rem, 2rem + 9vw, 9.5rem);
    line-height: 0.88;
  }
  .tag {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .tag p {
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.6rem);
    font-weight: 600;
    line-height: 1.3;
    max-width: 22ch;
  }
  .sub {
    color: var(--muted);
    max-width: 48ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 6px;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 18px;
  }
  .metrics li {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .m-label {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--muted);
  }
  .art {
    margin-inline: 0;
  }

  @media (max-width: 640px) {
    .metrics {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .metrics li {
      grid-template-columns: 7.5rem 1fr;
      align-items: baseline;
      gap: 14px;
    }
  }
  /* desktop: the copy is set right-aligned against the illustration, as in the reference */
  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: center;
      min-height: calc(100svh - var(--header-h));
    }
    .copy {
      justify-items: end;
      text-align: right;
    }
    .tag {
      flex-direction: row;
    }
    .sub,
    .tag p {
      margin-left: auto;
    }
    .actions {
      justify-content: flex-end;
    }
    .metrics {
      text-align: left;
    }
    .art {
      margin: 0 -3% 0 -2%;
    }
  }
</style>
