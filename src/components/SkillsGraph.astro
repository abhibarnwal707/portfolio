---
import { skills, groups, projectNodes } from '../data/skills';
import { sections } from '../data/site';

const nameOf = (id: string) => projectNodes.find((p) => p.id === id)!.name;
const byGroup = groups.map((g) => ({ group: g, items: skills.filter((s) => s.group === g) }));
const legend = [
  { group: 'Languages', token: '--g-lang' },
  { group: 'Machine Learning', token: '--g-ml' },
  { group: 'GenAI & Agents', token: '--g-genai' },
  { group: 'Search & Ranking', token: '--g-search' },
  { group: 'Data & Serving', token: '--g-data' },
];
// JSON consumed by the island; the lists below are the no-JS / screen-reader version of the same data.
const graphData = JSON.stringify({
  projects: projectNodes,
  skills: skills.map((s) => ({ name: s.name, group: s.group, projects: s.projects })),
});
---

<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="wrap">
    <header class="section-head reveal">
      <h2 id="skills-title">{sections.skills.heading}</h2>
      <p class="sub">{sections.skills.sub}</p>
    </header>

    <div class="layout" data-skills data-graph={graphData}>
      <div class="graph-wrap" hidden data-graph-wrap>
        <ul class="legend" aria-label="Legend">
          {
            legend.map((l) => (
              <li>
                <span class="swatch" style={`background: var(${l.token})`} aria-hidden="true" />
                {l.group}
              </li>
            ))
          }
          <li><span class="swatch project" aria-hidden="true" />Project</li>
        </ul>
        <div class="canvas" data-canvas></div>
      </div>

      <details class="lists" open data-lists>
        <summary class="label">Grouped list</summary>
        <div class="groups">
          {
            byGroup.map((g) => (
              <section class="group">
                <h3>{g.group}</h3>
                <ul>
                  {g.items.map((s) => (
                    <li>
                      <span class="skill">{s.name}</span>
                      {s.projects.length > 0 && (
                        <span class="used mono">{s.projects.map(nameOf).join(' · ')}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    gap: 24px;
  }
  .graph-wrap {
    display: grid;
    gap: 12px;
    order: 2;
  }
  .lists {
    order: 1;
  }
  @media (min-width: 768px) {
    .graph-wrap {
      order: 1;
    }
    .lists {
      order: 2;
    }
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .swatch {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .swatch.project {
    width: 14px;
    height: 14px;
    background: var(--accent);
  }
  .canvas {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .canvas :global(svg) {
    width: 100%;
    height: auto;
    touch-action: manipulation;
  }
  .canvas :global(.edge) {
    stroke: var(--line);
    stroke-width: 1.25;
    transition: stroke 180ms ease-out, opacity 180ms ease-out;
  }
  .canvas :global(.edge.on) {
    stroke: var(--accent);
    stroke-width: 2;
  }
  .canvas :global(.node) {
    cursor: pointer;
    transition: opacity 180ms ease-out;
  }
  .canvas :global(.node text) {
    font-family: var(--font-body);
    font-size: 12px;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .canvas :global(.node.project text) {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 13px;
  }
  .canvas :global(.node:focus-visible) {
    outline: none;
  }
  .canvas :global(.node:focus-visible circle) {
    stroke: var(--ink);
    stroke-width: 3;
  }
  .canvas :global(.dim) {
    opacity: 0.18;
  }

  .lists summary {
    cursor: pointer;
    padding: 8px 0;
  }
  .groups {
    display: grid;
    gap: 16px;
    margin-top: 8px;
  }
  .group {
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .group h3 {
    margin-bottom: 12px;
    font-size: 1.125rem;
  }
  .group ul {
    display: grid;
    gap: 8px;
  }
  .group li {
    display: grid;
    gap: 2px;
  }
  .skill {
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .used {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  @media (min-width: 640px) {
    .groups {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .groups {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  import { forceSimulation, forceLink, forceManyBody, forceCollide, forceX, forceY } from 'd3-force';
  import type { SimulationNodeDatum, SimulationLinkDatum } from 'd3-force';

  type Group = 'Languages' | 'Machine Learning' | 'GenAI & Agents' | 'Search & Ranking' | 'Data & Serving';
  interface Data {
    projects: { id: string; name: string }[];
    skills: { name: string; group: Group; projects: string[] }[];
  }
  interface N extends SimulationNodeDatum {
    id: string;
    label: string;
    kind: 'project' | 'skill';
    group?: Group;
    slug?: string;
    r: number;
  }
  type L = SimulationLinkDatum<N>;

  const SVG_NS = 'http://www.w3.org/2000/svg';
  const TOKENS: Record<Group, string> = {
    Languages: '--g-lang',
    'Machine Learning': '--g-ml',
    'GenAI & Agents': '--g-genai',
    'Search & Ranking': '--g-search',
    'Data & Serving': '--g-data',
  };

  const host = document.querySelector<HTMLElement>('[data-skills]');
  const wrap = host?.querySelector<HTMLElement>('[data-graph-wrap]');
  const canvas = host?.querySelector<HTMLElement>('[data-canvas]');
  const lists = host?.querySelector<HTMLDetailsElement>('[data-lists]');

  if (host && wrap && canvas) {
    const data: Data = JSON.parse(host.dataset.graph!);

    const el = <K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string | number> = {}) => {
      const node = document.createElementNS(SVG_NS, tag);
      for (const k in attrs) node.setAttribute(k, String(attrs[k]));
      return node;
    };

    const build = () => {
      const W = canvas.offsetWidth || 700;
      const H = W < 560 ? 520 : 540;

      const nodes: N[] = [
        ...data.projects.map((p): N => ({ id: p.id, label: p.name, kind: 'project', slug: p.id, r: 24 })),
        ...data.skills.map((s): N => ({ id: s.name, label: s.name, kind: 'skill', group: s.group, r: 7 })),
      ];
      const links: L[] = data.skills.flatMap((s) => s.projects.map((p) => ({ source: p, target: s.name })));

      // Projects anchor along the middle; skills settle around the projects that use them.
      const anchor: Record<string, number> = { redstring: 0.2, papertrail: 0.5, cartrank: 0.8 };
      const sim = forceSimulation<N>(nodes)
        .force('link', forceLink<N, L>(links).id((n) => n.id).distance(W < 560 ? 70 : 100).strength(0.6))
        .force('charge', forceManyBody<N>().strength((n) => (n.kind === 'project' ? -420 : -70)))
        .force('collide', forceCollide<N>().radius((n) => n.r + (n.kind === 'project' ? 18 : 24)))
        .force('x', forceX<N>((n) => (n.kind === 'project' ? W * anchor[n.id] : W / 2)).strength((n) => (n.kind === 'project' ? 0.35 : 0.04)))
        .force('y', forceY<N>(H / 2).strength((n) => (n.kind === 'project' ? 0.2 : 0.05)))
        .stop();
      // Settle it up front so the layout is stable and identical with reduced motion.
      for (let i = 0; i < 400; i++) sim.tick();

      const pad = 14;
      nodes.forEach((n) => {
        n.x = Math.max(n.r + pad, Math.min(W - n.r - pad, n.x ?? W / 2));
        n.y = Math.max(n.r + pad, Math.min(H - n.r - pad, n.y ?? H / 2));
      });

      const svg = el('svg', { viewBox: `0 0 ${W} ${H}`, role: 'group', 'aria-label': 'Skills connection map. The grouped list shows the same information as text.' });
      const edgeLayer = el('g');
      const nodeLayer = el('g');
      svg.append(edgeLayer, nodeLayer);

      const edgeEls = links.map((l) => {
        const s = l.source as N;
        const t = l.target as N;
        const line = el('line', { class: 'edge', x1: s.x!, y1: s.y!, x2: t.x!, y2: t.y! });
        edgeLayer.append(line);
        return { line, s, t };
      });

      const neighbours = new Map<string, Set<string>>();
      nodes.forEach((n) => neighbours.set(n.id, new Set([n.id])));
      links.forEach((l) => {
        neighbours.get((l.source as N).id)!.add((l.target as N).id);
        neighbours.get((l.target as N).id)!.add((l.source as N).id);
      });

      const nodeEls = new Map<string, SVGGElement>();
      let pinned: string | null = null;

      const focusOn = (id: string | null) => {
        const keep = id ? neighbours.get(id)! : null;
        nodeEls.forEach((g, nid) => g.classList.toggle('dim', !!keep && !keep.has(nid)));
        edgeEls.forEach(({ line, s, t }) => {
          const on = !!id && (s.id === id || t.id === id);
          line.classList.toggle('on', on);
          line.classList.toggle('dim', !!id && !on);
        });
      };

      nodes.forEach((n) => {
        const used = n.kind === 'skill' ? data.skills.find((s) => s.name === n.id)!.projects : [];
        const names = used.map((u) => data.projects.find((p) => p.id === u)!.name);
        const desc =
          n.kind === 'project'
            ? `${n.label}, project. Opens the case study.`
            : `${n.label}, ${n.group}${names.length ? `, used in ${names.join(', ')}` : ', not tied to a project'}`;

        const g = el('g', { class: `node ${n.kind}`, transform: `translate(${n.x},${n.y})`, tabindex: 0, role: n.kind === 'project' ? 'link' : 'button', 'aria-label': desc });
        const fill = n.kind === 'project' ? 'var(--accent)' : `var(${TOKENS[n.group!]})`;
        g.append(el('circle', { r: n.r, fill, stroke: 'var(--surface)', 'stroke-width': 2 }));

        const text = el('text', { y: n.kind === 'project' ? n.r + 16 : -n.r - 6, 'text-anchor': 'middle' });
        text.textContent = n.label;
        g.append(text);

        g.addEventListener('mouseenter', () => !pinned && focusOn(n.id));
        g.addEventListener('mouseleave', () => !pinned && focusOn(null));
        g.addEventListener('focus', () => focusOn(n.id));
        g.addEventListener('blur', () => focusOn(pinned));
        g.addEventListener('click', (e) => {
          e.stopPropagation();
          if (n.kind === 'project') {
            location.href = `/projects/${n.slug}`;
            return;
          }
          // tap toggles the highlight for touch screens
          pinned = pinned === n.id ? null : n.id;
          focusOn(pinned);
        });
        g.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            g.dispatchEvent(new MouseEvent('click', { bubbles: true }));
          }
          if (e.key === 'Escape') {
            pinned = null;
            focusOn(null);
          }
        });
        nodeEls.set(n.id, g);
        nodeLayer.append(g);
      });

      svg.addEventListener('click', () => {
        pinned = null;
        focusOn(null);
      });

      canvas.replaceChildren(svg);
    };

    build();
    wrap.hidden = false;
    // With the graph present, tuck the text list away on wider screens (it stays one click away).
    if (lists && matchMedia('(min-width: 768px)').matches) lists.open = false;

    let t: number | undefined;
    let lastW = canvas.offsetWidth;
    addEventListener('resize', () => {
      clearTimeout(t);
      t = window.setTimeout(() => {
        if (canvas.offsetWidth !== lastW) {
          lastW = canvas.offsetWidth;
          build();
        }
      }, 200);
    });
  }
</script>
