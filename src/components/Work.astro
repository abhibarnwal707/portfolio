---
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
import { media } from '../data/media';
import { sections } from '../data/site';
import Icon from './Icon.astro';
---

<section id="work" class="work section" aria-labelledby="work-title">
  <div class="wrap">
    <header class="section-head" data-reveal-group>
      <p class="label" data-reveal>Case files</p>
      <h2 id="work-title" data-reveal style="--i:1">{sections.work.heading}</h2>
      <p data-reveal style="--i:2">{sections.work.sub}</p>
    </header>

    <ul class="cards" data-reveal-group>
      {
        projects.map((p, i) => {
          const m = media[p.slug].cover;
          return (
            <li data-reveal style={`--i:${i}`}>
              <article class="frame-card card" aria-labelledby={`card-${p.slug}`}>
                <span class="notch">2026</span>
                <div class="pic" style={m.bg ? `background:${m.bg}` : undefined}>
                  <Image
                    src={m.src}
                    alt={m.alt}
                    widths={[480, 720, 960]}
                    sizes="(min-width: 1024px) 380px, (min-width: 700px) 50vw, 100vw"
                    loading="lazy"
                    style={m.fit === 'contain' ? 'object-fit:contain' : m.focus ? `object-position:${m.focus}` : undefined}
                  />
                  <span class="badge" aria-hidden="true">
                    <Icon name={p.slug} size={28} />
                  </span>
                </div>
                <h3 id={`card-${p.slug}`} class="display name">
                  {p.name}
                </h3>
                <p class="one">{p.oneLiner}</p>
                <ul class="nums">
                  {p.metrics.map((x) => (
                    <li>
                      <span class="big-num">{x.value}</span>
                      <span class="n-label">{x.label}</span>
                    </li>
                  ))}
                </ul>
                <ul class="ext">
                  {p.links.map((l) => (
                    <li>
                      <a class="link" href={l.href} target="_blank" rel="noopener noreferrer">
                        {l.label}
                      </a>
                    </li>
                  ))}
                </ul>
                <a class="btn view" href={`/projects/${p.slug}/`} aria-label={`View case ${p.name}`}>
                  <span class="btn-strip">
                    <Icon name="play" size={16} />
                  </span>
                  <span class="btn-text">View case</span>
                </a>
              </article>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .cards {
    display: grid;
    gap: 56px 28px;
  }
  .cards > li {
    display: grid;
  }
  .card {
    padding-bottom: 56px;
  }
  .card:hover {
    transform: translateY(-8px) rotate(-0.6deg);
  }
  .pic {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    background: var(--bg);
  }
  .pic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
  }
  .pic .badge {
    position: absolute;
    left: 14px;
    bottom: -24px;
    box-shadow: 0 0 0 5px var(--bg-deep);
    transition: transform 400ms var(--ease-out);
  }
  .card:hover .badge {
    transform: rotate(-12deg) scale(1.08);
  }
  .name {
    margin-top: 18px;
    font-size: clamp(2.2rem, 1.8rem + 1vw, 2.8rem);
    line-height: 1;
  }
  .one {
    color: var(--muted);
  }
  .nums {
    display: grid;
    gap: 14px;
  }
  .nums li {
    display: grid;
    gap: 2px;
    padding-left: 14px;
    border-left: 3px solid var(--yellow);
  }
  .nums .big-num {
    font-size: clamp(1.6rem, 1.2rem + 1vw, 2rem);
  }
  .n-label {
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--muted);
  }
  .ext {
    display: flex;
    gap: 20px;
    font-weight: 600;
  }
  /* the button hangs off the frame's bottom edge */
  .view {
    position: absolute;
    left: 50%;
    bottom: -30px;
    transform: translateX(-50%);
    white-space: nowrap;
    box-shadow: 0 0 0 6px var(--bg);
  }
  .view:hover {
    transform: translateX(-50%) translateY(-3px);
  }
  @media (min-width: 700px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1080px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
