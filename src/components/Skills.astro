---
import { skills, groups, projectNodes } from '../data/skills';
import { sections } from '../data/site';
import Icon from './Icon.astro';

const slug = (g: string) => g.toLowerCase().replace(/[^a-z]+/g, '-');
const nameOf = (id: string) => projectNodes.find((p) => p.id === id)!.name;
---

<section id="skills" class="skills section" aria-labelledby="skills-title">
  <div class="wrap">
    <header class="section-head" data-reveal-group>
      <p class="label" data-reveal>What I work with</p>
      <h2 id="skills-title" data-reveal style="--i:1">{sections.skills.heading}</h2>
      <p data-reveal style="--i:2">{sections.skills.sub}</p>
    </header>

    <div class="board" data-tabs>
      <div class="tabs-row">
        <div class="tabs" role="tablist" aria-label="Skill groups">
          <span class="tabs-pill" aria-hidden="true"></span>
          {
            groups.map((g, i) => (
              <button type="button" class="tab" role="tab" id={`st-${slug(g)}`} aria-controls={`sp-${slug(g)}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                {g}
              </button>
            ))
          }
        </div>
      </div>

      {
        groups.map((g) => (
          <div class="panel" role="tabpanel" id={`sp-${slug(g)}`} aria-labelledby={`st-${slug(g)}`}>
            <h3 class="panel-title">{g}</h3>
            <ul class="grid">
              {skills
                .filter((s) => s.group === g)
                .map((s, i) => (
                  <li class="skill" style={`--i:${i}`}>
                    <span class="s-name">{s.name}</span>
                    <span class="s-used">
                      {s.projects.length ? (
                        s.projects.map((p) => (
                          <span class="used" title={nameOf(p)}>
                            <Icon name={p} size={16} />
                            {nameOf(p)}
                          </span>
                        ))
                      ) : (
                        <span class="used none">Outside these three projects</span>
                      )}
                    </span>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .board {
    padding: clamp(24px, 4vw, 48px);
    border-radius: var(--radius);
    background: var(--bg-deep);
  }
  .tabs-row {
    display: flex;
    justify-content: center;
    margin-bottom: 36px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs {
    background: var(--bg);
  }
  .panel[hidden] {
    display: none;
  }
  .panel-title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  :global(html:not(.js)) .panel-title {
    position: static;
    width: auto;
    height: auto;
    clip-path: none;
    margin: 28px 0 14px;
  }
  .grid {
    display: grid;
    gap: 14px;
  }
  .skill {
    display: grid;
    gap: 10px;
    padding: 18px 20px;
    border: 2px solid var(--line);
    border-radius: 14px;
    background: var(--bg);
    transition: transform 260ms var(--ease-out), border-color 260ms ease;
  }
  .skill:hover {
    transform: translateY(-4px);
    border-color: var(--yellow);
  }
  @media (prefers-reduced-motion: no-preference) {
    .panel:not([hidden]) .skill {
      animation: chip-in 520ms var(--ease-expo) both;
      animation-delay: calc(var(--i) * 50ms);
    }
  }
  @keyframes chip-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  .s-name {
    font-size: 1.2rem;
    font-weight: 700;
  }
  .s-used {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .used {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--cream);
    color: var(--cream-ink);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .used.none {
    background: transparent;
    color: var(--muted);
    padding-left: 0;
    font-weight: 500;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .tabs-row {
      justify-content: flex-start;
    }
    .tab {
      white-space: nowrap;
    }
  }
</style>
