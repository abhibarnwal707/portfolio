---
interface Props {
  as?: 'a' | 'div';
  size?: 'md' | 'lg';
}
const { as = 'a', size = 'md' } = Astro.props;
const Tag = as;
---

<Tag class:list={['logo', size]} href={as === 'a' ? '/' : undefined} aria-label={as === 'a' ? 'AK Abhishek Kumar, home' : undefined}>
  <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
  <span class="mono" aria-hidden="true">AK</span>
  <span class="name" aria-hidden={as === 'a' ? 'true' : undefined}>
    <span>Abhishek</span>
    <span>Kumar</span>
  </span>
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    height: 100%;
    padding: 12px 22px 12px 16px;
    border-radius: 12px;
    background: var(--cream);
    color: var(--cream-ink);
    text-decoration: none;
  }
  .dots {
    display: grid;
    grid-template-columns: repeat(2, 5px);
    gap: 7px 7px;
  }
  .dots i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--cream-ink);
  }
  .dots i:first-child {
    grid-column: 2;
  }
  .mono {
    display: grid;
    place-items: center;
    padding: 4px 7px 2px;
    border-radius: 6px;
    background: var(--cream-ink);
    color: var(--cream);
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1;
    letter-spacing: 0.02em;
    transition: transform 300ms var(--ease-out);
  }
  .logo:hover .mono {
    transform: rotate(-6deg) scale(1.06);
  }
  .name {
    display: grid;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.5em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .lg {
    padding: 16px 28px 16px 20px;
  }
  .lg .mono {
    font-size: 2.6rem;
  }
  .lg .name {
    font-size: 0.95rem;
  }
</style>
