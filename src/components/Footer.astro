---
import { site, nav } from '../data/site';
import { placeCredit } from '../data/media';
import Logo from './Logo.astro';
---

<footer class="site-footer wrap">
  <div class="panel">
    <div class="brand">
      <Logo as="div" size="lg" />
      <p>{site.role} in {site.location}. Building AI that is measured, explained and shipped.</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href={site.resume} target="_blank" rel="noopener noreferrer">Resume</a></li>
      </ul>
    </nav>
    <div class="contact">
      <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
      <p data-clock data-zone={site.timeZone} data-city={site.city}>{site.location}</p>
    </div>
  </div>

  <p class="copy">
    © {site.year} {site.name} ·
    <a class="link" href={placeCredit.href} target="_blank" rel="noopener noreferrer">{placeCredit.text}</a>
  </p>
  <p class="final">
    <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
      More on LinkedIn <span class="arrow" aria-hidden="true">→</span>
    </a>
  </p>
</footer>

<style>
  .site-footer {
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: 40px;
  }
  .panel {
    display: grid;
    gap: 32px;
    padding-top: clamp(32px, 4vw, 48px);
    border-top: 2px solid var(--line);
  }
  .brand {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .brand p {
    max-width: 36ch;
    color: var(--muted);
  }
  nav ul {
    display: grid;
    gap: 8px;
  }
  nav a {
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 180ms ease;
  }
  nav a:hover {
    color: var(--yellow);
  }
  .contact {
    display: grid;
    gap: 6px;
    align-content: start;
    font-weight: 600;
  }
  .contact p {
    color: var(--muted);
  }
  .copy {
    margin: 28px auto 0;
    max-width: none;
    font-size: 0.875rem;
    text-align: center;
    color: var(--muted);
  }
  .final {
    margin: 14px auto 0;
    max-width: none;
    text-align: center;
    font-size: 1.25rem;
  }
  .final a {
    display: inline-block;
    padding: 6px 4px;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }
  .arrow {
    display: inline-block;
    transition: transform 200ms var(--ease-out);
  }
  .final a:hover .arrow,
  .final a:focus-visible .arrow {
    transform: translateX(6px);
  }
  @media (min-width: 860px) {
    .panel {
      grid-template-columns: 1.4fr 0.8fr 1fr;
      align-items: start;
    }
  }
</style>
