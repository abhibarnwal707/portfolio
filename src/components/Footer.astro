---
import { Image } from 'astro:assets';
import { site, nav } from '../data/site';
import { place, placeCredit } from '../data/media';
---

<footer class="site-footer">
  <Image class="photo" src={place.src} alt="" widths={[800, 1400, 1920]} sizes="100vw" loading="lazy" />
  <div class="layer frame">
    <div class="top">
      <nav aria-label="Footer">
        <ul>
          {nav.map((l) => <li><a class="link" href={l.href}>{l.label}</a></li>)}
          <li><a class="link" href={site.resume} target="_blank" rel="noopener noreferrer">Resume</a></li>
        </ul>
      </nav>
      <div class="contact">
        <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
        <p data-clock data-zone={site.timeZone} data-city={site.city}>{site.location}</p>
      </div>
    </div>

    <p class="wordmark" aria-hidden="true">{site.name}</p>

    <div class="foot">
      <p class="small">
        © {site.year} {site.name} ·
        <a class="link" href={placeCredit.href} target="_blank" rel="noopener noreferrer">{placeCredit.text}</a>
      </p>
      <p class="final">
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
          More on LinkedIn <span class="arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: calc(var(--section-gap) / 2);
    /* at the very bottom of the page the footer starts just below the sticky header */
    min-height: min(calc(100svh - var(--header-h)), 900px);
    display: grid;
    color: #ecebe5;
    background: #161513;
    overflow: hidden;
  }
  .photo {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
    filter: brightness(0.5);
  }
  .layer {
    grid-area: 1 / 1;
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    padding-block: 32px 40px;
  }
  .top {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    font-size: var(--step-small);
  }
  .top ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .contact {
    text-align: right;
  }
  .contact p {
    margin-left: auto;
  }
  .wordmark {
    align-self: end;
    max-width: none;
    margin-top: 48px;
    font-weight: 600;
    font-size: 13.6vw;
    line-height: 0.85;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }
  .foot {
    display: grid;
    gap: 16px;
    justify-items: center;
    margin-top: 32px;
    text-align: center;
  }
  .final {
    font-size: var(--step-lead);
  }
  .final a {
    display: inline-block;
    padding: 6px 4px;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }
  .arrow {
    display: inline-block;
    transition: transform var(--t-hover) var(--ease-out);
  }
  .final a:hover .arrow,
  .final a:focus-visible .arrow {
    transform: translateX(6px);
  }
  @media (max-width: 640px) {
    .site-footer {
      min-height: min(88svh, calc(100svh - var(--header-h)));
    }
    .top {
      flex-direction: column;
    }
    .contact {
      text-align: left;
    }
    .contact p {
      margin-left: 0;
    }
  }
</style>
