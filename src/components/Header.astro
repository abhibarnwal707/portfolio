---
import { site, nav } from '../data/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header wrap">
  <div class="bar">
    <Logo />

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href={site.resume} target="_blank" rel="noopener noreferrer">Resume</a></li>
      </ul>
    </nav>

    <div class="actions">
      <ThemeToggle />
      <a class="round social" href={site.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <Icon name="github" size={18} />
      </a>
      <a class="round social" href={site.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <Icon name="linkedin" size={17} />
      </a>

      <details class="menu" data-menu>
        <summary class="round" aria-label="Menu">
          <span class="open"><Icon name="menu" /></span>
          <span class="close"><Icon name="close" /></span>
        </summary>
        <nav class="panel" aria-label="Primary mobile">
          <ul>
            {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            <li><a href={site.resume} target="_blank" rel="noopener noreferrer">Resume</a></li>
            <li><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
            <li><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: 14px;
    padding-bottom: 10px;
    background: var(--bg);
    transition: background-color 400ms ease;
  }
  /* the reference's rounded bar: the logo block sits flush in its left end */
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 76px;
    padding-right: 14px;
    border: 2px solid var(--line);
    border-radius: 14px;
  }
  .bar :global(.logo) {
    margin: -2px 0 -2px -2px;
    height: calc(100% + 4px);
    border-radius: 14px 0 0 14px;
  }
  .nav-desktop {
    margin-inline: auto;
  }
  .nav-desktop ul {
    display: flex;
    gap: clamp(20px, 3.4vw, 52px);
  }
  .nav-desktop a {
    position: relative;
    display: block;
    padding-block: 8px;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .nav-desktop a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--yellow);
    transform: translateX(-50%) scale(0);
    transition: transform 260ms var(--ease-out);
  }
  .nav-desktop a:hover::after {
    transform: translateX(-50%) scale(1);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }
  .nav-desktop + .actions {
    margin-left: 0;
  }
  .menu {
    position: relative;
    display: none;
  }
  .menu summary {
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu .close,
  .menu[open] .open {
    display: none;
  }
  .menu[open] .close {
    display: block;
  }
  .menu:not([open]) .panel {
    display: none;
  }
  .panel {
    position: absolute;
    right: 0;
    top: 58px;
    min-width: 230px;
    padding: 8px;
    background: var(--cream);
    color: var(--cream-ink);
    border-radius: 14px;
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.25);
    transform-origin: top right;
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu[open] .panel {
      animation: menu-in 260ms var(--ease-out);
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: scale(0.94) translateY(-8px);
    }
  }
  .panel a {
    display: block;
    padding: 12px 14px;
    border-radius: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .panel a:hover {
    background: var(--cream-2);
  }
  @media (max-width: 1000px) {
    .nav-desktop,
    .social {
      display: none;
    }
    .menu {
      display: block;
    }
  }
  @media (max-width: 520px) {
    .bar {
      height: 64px;
      gap: 10px;
    }
    .bar :global(.name) {
      display: none;
    }
  }
</style>
