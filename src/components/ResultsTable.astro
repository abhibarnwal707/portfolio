---
interface Props {
  rows: { measure: string; result: string }[];
}
const { rows } = Astro.props;
---

<div class="table-wrap">
  <table>
    <thead>
      <tr><th scope="col">Measure</th><th scope="col">Result</th></tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <th scope="row">{r.measure}</th>
            <td>{r.result}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table-wrap {
    overflow-x: auto;
    border-radius: var(--radius);
    background: var(--bg-deep);
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th,
  td {
    padding: 18px 22px;
    text-align: left;
    vertical-align: top;
    border-bottom: 2px solid var(--line);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--yellow);
  }
  tbody th {
    font-weight: 700;
    width: 42%;
  }
  td {
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  tbody tr {
    transition: background-color 220ms ease;
  }
  tbody tr:hover {
    background: var(--bg);
  }
  @media (max-width: 560px) {
    th,
    td {
      padding: 14px;
    }
  }
</style>
