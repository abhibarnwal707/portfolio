---
interface Props {
  rows: { measure: string; result: string }[];
}
const { rows } = Astro.props;
---

<div class="table-wrap">
  <table>
    <thead>
      <tr><th scope="col">Measure</th><th scope="col">Result</th></tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <th scope="row">{r.measure}</th>
            <td>{r.result}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table-wrap {
    overflow-x: auto;
    border-radius: var(--radius);
    background: var(--surface);
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th,
  td {
    padding: 16px 20px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--surface-2); /* taste-skill-ignore: a real table */
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    font-size: var(--step-small);
    font-weight: 600;
    color: var(--muted);
    background: var(--surface-2);
  }
  tbody th {
    font-weight: 500;
    width: 42%;
  }
  td {
    font-variant-numeric: tabular-nums lining-nums;
  }
  @media (max-width: 560px) {
    th,
    td {
      padding: 12px 14px;
    }
  }
</style>
