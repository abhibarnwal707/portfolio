---
import { Image } from 'astro:assets';
import { site, sections } from '../data/site';
import { place } from '../data/media';
import Icon from './Icon.astro';

const c = sections.contact;
---

<section id="contact" class="contact section" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="panel" data-reveal-group>
      <div class="left">
        <p class="label" data-reveal>Get in touch</p>
        <h2 id="contact-title" data-reveal style="--i:1">{c.heading}</h2>
        <p data-reveal style="--i:2">{c.prompt[0]} {c.text}</p>

        <div class="mail" data-reveal style="--i:3">
          <a class="address" href={`mailto:${site.email}`}>{site.email}</a>
          <button type="button" class="copy" data-copy={site.email}>
            <Icon name="copy" size={16} /><span data-copy-label aria-live="polite">Copy</span>
          </button>
        </div>

        <!-- No backend: the form opens the visitor's email app with their line as the body. -->
        <form class="field" action={`mailto:${site.email}`} method="get" enctype="text/plain" data-mail data-reveal style="--i:4">
          <input type="hidden" name="subject" value="Hello from your portfolio" />
          <label class="sr-only" for="mail-body">Your message</label>
          <input id="mail-body" name="body" type="text" placeholder={c.placeholder} autocomplete="off" />
          <button type="submit" class="btn send">
            <span class="btn-strip"><Icon name="play" size={16} /></span>
            <span class="btn-text">Send</span>
          </button>
        </form>
        <p class="note" data-reveal style="--i:5">{c.note}</p>

        <ul class="socials" data-reveal style="--i:6">
          <li><a class="round" href={site.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Icon name="github" size={18} /></a></li>
          <li><a class="round" href={site.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><Icon name="linkedin" size={17} /></a></li>
          <li><a class="round" href={`mailto:${site.email}`} aria-label="Email"><Icon name="mail" size={18} /></a></li>
        </ul>
      </div>

      <figure class="photo" data-reveal style="--i:2">
        <Image src={place.src} alt={place.alt} widths={[480, 800, 1200]} sizes="(min-width: 1000px) 520px, 100vw" loading="lazy" />
        <figcaption>Based in {site.city}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    padding: clamp(24px, 4.5vw, 64px);
    border-radius: var(--radius);
    background: var(--bg-deep);
    overflow: hidden;
  }
  .left {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    justify-items: start;
    align-content: start;
  }
  .left > p {
    color: var(--muted);
  }
  .mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }
  .address {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 0.9rem + 2.2vw, 2.4rem);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 200ms ease;
  }
  .address:hover {
    color: var(--yellow);
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 14px;
    border: 2px solid var(--cream);
    border-radius: 999px;
    background: transparent;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .copy:hover {
    background: var(--cream);
    color: var(--cream-ink);
  }
  :global(html:not(.js)) .copy {
    display: none;
  }
  .field {
    display: flex;
    width: 100%;
    max-width: 560px;
    gap: 10px;
  }
  .field input[type='text'] {
    flex: 1;
    min-width: 0;
    height: 52px;
    padding: 0 18px;
    border: 2px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg);
    outline: none;
    transition: border-color 200ms ease;
  }
  .field input::placeholder {
    color: var(--muted);
  }
  .field input:focus-visible {
    border-color: var(--yellow);
  }
  .note {
    font-size: 0.85rem;
  }
  .send .btn-text {
    padding: 0 18px 0 14px;
  }
  .send .btn-strip {
    width: 44px;
  }
  .socials {
    display: flex;
    gap: 10px;
  }
  .socials .round {
    background: var(--bg);
  }
  /* a cream-framed picture, like the reference's closing collage */
  .photo {
    position: relative;
    align-self: stretch;
    min-height: 320px;
    border: 6px solid var(--cream);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1200ms var(--ease-out);
  }
  .photo:hover :global(img) {
    transform: scale(1.05);
  }
  figcaption {
    position: absolute;
    left: 14px;
    bottom: 14px;
    padding: 6px 14px;
    border-radius: 8px;
    background: var(--cream);
    color: var(--cream-ink);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  @media (min-width: 1000px) {
    .panel {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }
  }
</style>
