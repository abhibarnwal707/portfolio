---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Case not found | Abhishek Kumar" description="This page is not in the case file.">
  <section class="nf">
    <div class="wrap">
      <p class="label">CASE 404</p>
      <h1>Case not found</h1>
      <span class="thread thread-short" aria-hidden="true"></span>
      <p class="text">The string ends here. That page isn't in the file, but the rest of the cases are.</p>
      <a class="btn btn-primary" href="/">Back to the case file <Icon name="arrow" size={18} /></a>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: 96px 120px;
  }
  .wrap {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  h1 {
    font-size: clamp(2.5rem, 8vw, 5rem);
    letter-spacing: -0.03em;
  }
  .text {
    color: var(--muted);
  }
</style>
