---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Case not found | Abhishek Kumar" description="This page is not in the case file.">
  <section class="nf frame">
    <h1><span class="rise"><span>Case not found</span></span></h1>
    <p class="lead fade-in" style="--i:1">That page isn't here, but the three cases are.</p>
    <a class="btn btn-accent fade-in" style="--i:2" href="/#work">Back to the work <Icon name="arrow" size={18} /></a>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 28px;
    justify-items: start;
    align-content: center;
    min-height: calc(70svh - var(--header-h));
    padding-block: 64px;
  }
  h1 {
    font-size: var(--step-display);
    letter-spacing: -0.035em;
  }
</style>
