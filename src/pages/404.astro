---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Case not found | Abhishek Kumar" description="This page is not in the case file.">
  <section class="nf wrap">
    <p class="label fade-in">Error 404</p>
    <h1><span class="rise"><span>Case not found</span></span></h1>
    <p class="fade-in" style="--i:1">That page isn't here, but the three cases are.</p>
    <a class="btn fade-in" style="--i:2" href="/#work">
      <span class="btn-strip"><Icon name="play" size={16} /></span>
      <span class="btn-text">Back to the work</span>
    </a>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 24px;
    justify-items: center;
    align-content: center;
    min-height: calc(70svh - var(--header-h));
    padding-block: 64px;
    text-align: center;
  }
  h1 {
    font-size: clamp(3.5rem, 2rem + 7vw, 8rem);
  }
</style>
