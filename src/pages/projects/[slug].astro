---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Diagram from '../../components/Diagram.astro';
import ResultsTable from '../../components/ResultsTable.astro';
import BaselineRows from '../../components/BaselineRows.astro';
import LoopMedia from '../../components/LoopMedia.astro';
import { projects } from '../../data/projects';
import { media } from '../../data/media';
import { sections } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const m = media[project.slug];
const others = projects.filter((p) => p.slug !== project.slug);
const toc = [
  { id: 'problem', label: 'The problem' },
  { id: 'built', label: 'What I built' },
  { id: 'results', label: 'Results' },
  { id: 'decisions', label: 'Engineering decisions' },
  { id: 'stack', label: 'Stack' },
];
const fit = (p: { fit?: string; focus?: string }) => (p.fit === 'contain' ? 'object-fit:contain' : p.focus ? `object-position:${p.focus}` : undefined);
---

<Base title={`${project.name} | Abhishek Kumar`} description={project.oneLiner}>
  <article>
    <header class="top wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/#work">Work</a>
        <Icon name="chevron" size={16} />
        <span aria-current="page">{project.name}</span>
      </nav>

      <div class="intro">
        <div class="copy">
          <p class="label fade-in">Case study · 2026</p>
          <h1><span class="rise"><span>{project.name}</span></span></h1>
          <p class="lead fade-in" style="--i:1">{project.title.split(': ')[1] ?? project.title}</p>
          <p class="muted fade-in" style="--i:2">{project.oneLiner}</p>
          <div class="actions fade-in" style="--i:3">
            {
              project.links.map((l, i) =>
                i === 0 ? (
                  <a class="btn" href={l.href} target="_blank" rel="noopener noreferrer">
                    <span class="btn-strip">
                      <Icon name="play" size={16} />
                    </span>
                    <span class="btn-text">{l.label}</span>
                  </a>
                ) : (
                  <a class="btn-ghost" href={l.href} target="_blank" rel="noopener noreferrer">
                    {l.label} <Icon name="external" size={16} />
                  </a>
                ),
              )
            }
          </div>
          <ul class="tags fade-in" style="--i:4" aria-label="Tags">
            {project.tags.map((t) => <li class="chip">{t}</li>)}
          </ul>
        </div>

        <figure class="frame-card cover fade-in" style="--i:2">
          <span class="notch">2026</span>
          <div class="cover-pic" style={m.cover.bg ? `background:${m.cover.bg}` : undefined}>
            <Image src={m.cover.src} alt={m.cover.alt} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 600px, 100vw" loading="eager" style={fit(m.cover)} />
          </div>
          <figcaption>
            <span class="badge" aria-hidden="true"><Icon name={project.slug} size={26} /></span>
            {m.cover.caption}
          </figcaption>
        </figure>
      </div>
    </header>

    <section class="figures wrap" aria-label="Headline results" data-reveal-group>
      <ul>
        {
          project.metrics.map((x, i) => (
            <li data-reveal style={`--i:${i}`}>
              <span class="big-num">{x.value}</span>
              <span class="muted">{x.label}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="evidence wrap" aria-labelledby="ev-h" data-reveal-group>
      <header class="section-head">
        <p class="label" data-reveal>The evidence</p>
        <h2 id="ev-h" data-reveal style="--i:1">{sections.work.compareLabel}</h2>
      </header>
      <div data-reveal style="--i:2"><BaselineRows project={project} /></div>
    </section>

    <div class="body wrap">
      <nav class="toc" aria-label="On this page">
        <p class="label">On this page</p>
        <ul>
          {toc.map((t) => <li><a href={`#${t.id}`} data-toc={t.id}>{t.label}</a></li>)}
        </ul>
      </nav>

      <div class="content">
        <section id="problem" class="block" aria-labelledby="problem-h" data-reveal-group>
          <h2 id="problem-h" data-reveal>The problem</h2>
          <p class="big-p" data-reveal style="--i:1">{project.problem}</p>
        </section>

        <section id="built" class="block" aria-labelledby="built-h" data-reveal-group>
          <h2 id="built-h" data-reveal>What I built</h2>
          <ol class="built">
            {
              project.built.map((b, i) => (
                <li data-reveal style={`--i:${Math.min(i + 1, 6)}`}>
                  <span class="step" aria-hidden="true">
                    {i + 1}
                  </span>
                  <div>
                    <h3>{b.title.replace(/\.$/, '')}</h3>
                    <p class="muted">{b.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="frame-card diag" data-reveal>
            <span class="notch">How it fits together</span>
            <Diagram project={project} />
          </div>
        </section>

        {
          (m.loop || m.gallery.length > 0) && (
            <section class="block" aria-labelledby="seen-h" data-reveal-group>
              <h2 id="seen-h" data-reveal>
                {project.name} in use
              </h2>
              {m.loop && (
                <figure class="frame-card shot" data-reveal style="--i:1">
                  <span class="notch">Demo</span>
                  <LoopMedia loop={m.loop} />
                  <figcaption class="muted">{m.loop.caption}</figcaption>
                </figure>
              )}
              {m.gallery.map((g, i) => (
                <figure class="frame-card shot" data-reveal style={`--i:${i + 2}`}>
                  <Image src={g.src} alt={g.alt} widths={[640, 1024, 1400]} sizes="(min-width: 1180px) 820px, 100vw" loading="lazy" />
                  <figcaption class="muted">{g.caption}</figcaption>
                </figure>
              ))}
            </section>
          )
        }

        <section id="results" class="block" aria-labelledby="results-h" data-reveal-group>
          <h2 id="results-h" data-reveal>Results</h2>
          <div data-reveal style="--i:1"><ResultsTable rows={project.results} /></div>
        </section>

        <section id="decisions" class="block" aria-labelledby="decisions-h" data-reveal-group>
          <h2 id="decisions-h" data-reveal>Engineering decisions</h2>
          <ul class="decisions">
            {
              project.decisions.map((d, i) => (
                <li data-reveal style={`--i:${i + 1}`}>
                  <span class="badge-ring small" aria-hidden="true">
                    <Icon name="target" size={18} />
                  </span>
                  <p>{d}</p>
                </li>
              ))
            }
          </ul>
        </section>

        <section id="stack" class="block" aria-labelledby="stack-h" data-reveal-group>
          <h2 id="stack-h" data-reveal>Stack</h2>
          <ul class="tags" data-reveal style="--i:1">
            {project.stack.map((s) => <li class="chip">{s}</li>)}
          </ul>
        </section>
      </div>
    </div>

    <section class="more wrap section" aria-labelledby="more-h" data-reveal-group>
      <header class="section-head">
        <p class="label" data-reveal>Keep reading</p>
        <h2 id="more-h" data-reveal style="--i:1">More cases</h2>
      </header>
      <ul class="more-cards">
        {
          others.map((o, i) => {
            const om = media[o.slug].cover;
            return (
              <li data-reveal style={`--i:${i + 2}`}>
                <article class="frame-card mcard">
                  <span class="notch">2026</span>
                  <div class="m-pic" style={om.bg ? `background:${om.bg}` : undefined}>
                    <Image src={om.src} alt={om.alt} widths={[480, 800]} sizes="(min-width: 768px) 50vw, 100vw" loading="lazy" style={fit(om)} />
                  </div>
                  <h3 class="display m-name">{o.name}</h3>
                  <p class="muted">{o.oneLiner}</p>
                  <a class="btn view" href={`/projects/${o.slug}/`} aria-label={`View case ${o.name}`}>
                    <span class="btn-strip">
                      <Icon name="play" size={16} />
                    </span>
                    <span class="btn-text">View case</span>
                  </a>
                </article>
              </li>
            );
          })
        }
      </ul>
    </section>
  </article>
</Base>

<style>
  .top {
    padding-top: 28px;
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 32px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }
  .crumbs a {
    text-decoration: none;
    color: var(--muted);
  }
  .crumbs a:hover {
    color: var(--yellow);
  }
  .intro {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  h1 {
    font-size: clamp(4rem, 2rem + 8vw, 8.5rem);
    line-height: 0.88;
  }
  .lead {
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.6rem);
    font-weight: 600;
    line-height: 1.3;
    max-width: 30ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cover {
    margin: 0;
  }
  .cover-pic {
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg);
  }
  .cover-pic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover figcaption {
    display: flex;
    align-items: center;
    gap: 14px;
    font-weight: 600;
  }

  .figures {
    padding-block: clamp(56px, 7vw, 96px) 0;
  }
  .figures ul {
    display: grid;
    gap: 28px;
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radius);
    background: var(--bg-deep);
  }
  .figures li {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .evidence {
    padding-block: clamp(72px, 9vw, 120px) 0;
  }

  .body {
    display: grid;
    gap: 40px;
    padding-top: clamp(72px, 9vw, 120px);
  }
  .toc {
    display: none;
  }
  .content {
    display: grid;
    gap: clamp(64px, 8vw, 104px);
    min-width: 0;
  }
  .block {
    display: grid;
    gap: 28px;
  }
  .big-p {
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.35rem);
    line-height: 1.6;
  }
  .built {
    display: grid;
    gap: 0;
    border-top: 2px solid var(--line);
  }
  .built li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 2px solid var(--line);
  }
  .step {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--yellow-ink);
    font-family: var(--font-display);
    font-size: 1.5rem;
  }
  .built h3 {
    margin-bottom: 4px;
  }
  .diag {
    padding-top: 44px;
  }
  .shot {
    margin: 0;
  }
  .shot :global(img),
  .shot :global(video) {
    width: 100%;
    height: auto;
    border-radius: 10px;
  }
  .decisions {
    display: grid;
    gap: 18px;
  }
  .decisions li {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 16px;
    align-items: start;
  }
  .badge-ring.small {
    width: 40px;
    height: 40px;
    border-width: 2px;
  }

  .more-cards {
    display: grid;
    gap: 56px 28px;
  }
  .more-cards > li {
    display: grid;
  }
  .mcard {
    padding-bottom: 56px;
  }
  .mcard:hover {
    transform: translateY(-8px) rotate(-0.6deg);
  }
  .m-pic {
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg);
  }
  .m-pic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .m-name {
    font-size: 2.4rem;
  }
  .view {
    position: absolute;
    left: 50%;
    bottom: -30px;
    transform: translateX(-50%);
    white-space: nowrap;
    box-shadow: 0 0 0 6px var(--bg);
  }
  .view:hover {
    transform: translateX(-50%) translateY(-3px);
  }

  @media (min-width: 640px) {
    .figures ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 768px) {
    .more-cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .body {
      grid-template-columns: 230px minmax(0, 1fr);
      gap: clamp(48px, 6vw, 96px);
    }
    .content {
      max-width: 860px;
    }
    .toc {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 32px);
      align-self: start;
    }
    .toc ul {
      display: grid;
      gap: 4px;
      margin-top: 16px;
    }
    .toc a {
      display: block;
      padding: 10px 14px;
      border-radius: var(--radius-sm);
      font-weight: 600;
      text-decoration: none;
      color: var(--muted);
      transition: background-color 220ms ease, color 220ms ease;
    }
    .toc a:hover {
      color: var(--ink);
    }
    .toc a.on {
      background: var(--cream);
      color: var(--cream-ink);
    }
  }
</style>

<script>
  // Mark the section being read in the table of contents.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((l) => l.classList.toggle('on', l.dataset.toc === e.target.id));
      });
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );
  links.forEach((l) => {
    const s = document.getElementById(l.dataset.toc!);
    if (s) io.observe(s);
  });
</script>
