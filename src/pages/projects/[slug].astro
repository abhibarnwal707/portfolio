---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Diagram from '../../components/Diagram.astro';
import ResultsTable from '../../components/ResultsTable.astro';
import Compare from '../../components/Compare.astro';
import LoopMedia from '../../components/LoopMedia.astro';
import { projects } from '../../data/projects';
import { media } from '../../data/media';
import { sections } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const others = projects.filter((p) => p.slug !== project.slug);
const m = media[project.slug];
const toc = [
  { id: 'problem', label: 'The problem' },
  { id: 'built', label: 'What I built' },
  { id: 'results', label: 'Results' },
  { id: 'decisions', label: 'Engineering decisions' },
  { id: 'stack', label: 'Stack' },
];
const coverStyle = m.cover.fit === 'contain' ? 'object-fit:contain' : m.cover.focus ? `object-position:${m.cover.focus}` : undefined;
---

<Base title={`${project.name} | Abhishek Kumar`} description={project.oneLiner}>
  <article class="case">
    <header class="top frame">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a class="link" href="/#work">Work</a> <span aria-hidden="true">/</span>
        <span aria-current="page">{project.name}</span>
      </nav>

      <div class="title">
        <h1>
          <span class="rise"><span>{project.name}</span></span>
        </h1>
        <p class="lead fade-in" style="--i:1">{project.title.split(': ')[1] ?? project.title}</p>
        <p class="fade-in" style="--i:2">{project.oneLiner}</p>
        <ul class="links fade-in" style="--i:3">
          {
            project.links.map((l, i) => (
              <li>
                <a class:list={['btn', { 'btn-accent': i === 0, 'btn-quiet': i > 0 }]} href={l.href} target="_blank" rel="noopener noreferrer">
                  {l.label} <Icon name="external" size={16} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    <div class="tags ticker" style="--ticker-speed:24s" aria-label="Tags">
      <div class="ticker-track">
        {
          [0, 1, 2, 3].map((copy) => (
            <ul class="ticker-group" aria-hidden={copy > 0 ? 'true' : undefined}>
              {project.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>

    <figure class="cover frame fade-in" style="--i:4">
      <div class="cover-pic" style={m.cover.bg ? `background:${m.cover.bg}` : undefined}>
        <Image src={m.cover.src} alt={m.cover.alt} widths={[640, 1024, 1600]} sizes="(min-width: 1180px) 1100px, 100vw" loading="eager" style={coverStyle} />
      </div>
      <figcaption class="small">{m.cover.caption}</figcaption>
    </figure>

    <section class="evidence frame" aria-labelledby="evidence-h" data-reveal-group>
      <h2 id="evidence-h" data-reveal>Headline results</h2>
      <ul class="figures">
        {
          project.metrics.map((x, i) => (
            <li data-reveal style={`--i:${i + 1}`}>
              <span class="value num">{x.value}</span>
              <span class="label">{x.label}</span>
            </li>
          ))
        }
      </ul>
      <div class="cmp" data-reveal style="--i:4">
        <Compare project={project} label={sections.work.compareLabel} />
      </div>
    </section>

    <div class="body frame">
      <nav class="toc" aria-label="On this page">
        <p class="toc-title">On this page</p>
        <ul>
          {toc.map((t) => <li><a href={`#${t.id}`} data-toc={t.id}>{t.label}</a></li>)}
        </ul>
      </nav>

      <div class="content">
        <section id="problem" class="block" aria-labelledby="problem-h" data-reveal-group>
          <h2 id="problem-h" data-reveal>The problem</h2>
          <p data-reveal style="--i:1">{project.problem}</p>
        </section>

        <section id="built" class="block" aria-labelledby="built-h" data-reveal-group>
          <h2 id="built-h" data-reveal>What I built</h2>
          <ol class="built">
            {
              project.built.map((b, i) => (
                <li data-reveal style={`--i:${Math.min(i + 1, 6)}`}>
                  <strong>{b.title}</strong> {b.text}
                </li>
              ))
            }
          </ol>
          <div data-reveal>
            <Diagram project={project} />
          </div>
        </section>

        {
          (m.loop || m.gallery.length > 0) && (
            <section class="block" aria-labelledby="seen-h" data-reveal-group>
              <h2 id="seen-h" data-reveal>
                {project.name} in use
              </h2>
              {m.loop && (
                <figure class="shot" data-reveal style="--i:1">
                  <LoopMedia loop={m.loop} />
                  <figcaption class="small">{m.loop.caption}</figcaption>
                </figure>
              )}
              {m.gallery.map((g, i) => (
                <figure class="shot" data-reveal style={`--i:${i + 2}`}>
                  <Image src={g.src} alt={g.alt} widths={[640, 1024, 1400]} sizes="(min-width: 1180px) 820px, 100vw" loading="lazy" />
                  <figcaption class="small">{g.caption}</figcaption>
                </figure>
              ))}
            </section>
          )
        }

        <section id="results" class="block" aria-labelledby="results-h" data-reveal-group>
          <h2 id="results-h" data-reveal>Results</h2>
          <div data-reveal style="--i:1"><ResultsTable rows={project.results} /></div>
        </section>

        <section id="decisions" class="block" aria-labelledby="decisions-h" data-reveal-group>
          <h2 id="decisions-h" data-reveal>Engineering decisions</h2>
          <ul class="decisions">
            {project.decisions.map((d, i) => <li data-reveal style={`--i:${i + 1}`}>{d}</li>)}
          </ul>
        </section>

        <section id="stack" class="block" aria-labelledby="stack-h" data-reveal-group>
          <h2 id="stack-h" data-reveal>Stack</h2>
          <p data-reveal style="--i:1">{project.stack.join(', ')}.</p>
        </section>
      </div>
    </div>

    <section class="more frame" aria-labelledby="more-h" data-reveal-group>
      <h2 id="more-h" data-reveal>More cases</h2>
      <ul class="more-list">
        {
          others.map((o, i) => {
            const om = media[o.slug].cover;
            return (
              <li data-reveal style={`--i:${i + 1}`}>
                <a href={`/projects/${o.slug}/`} class="more-item">
                  <span class="more-pic" style={om.bg ? `background:${om.bg}` : undefined}>
                    <Image
                      src={om.src}
                      alt={om.alt}
                      widths={[480, 800, 1100]}
                      sizes="(min-width: 768px) 50vw, 100vw"
                      loading="lazy"
                      style={om.fit === 'contain' ? 'object-fit:contain' : om.focus ? `object-position:${om.focus}` : undefined}
                    />
                  </span>
                  <span class="more-name">
                    {o.name} <Icon name="arrow" size={22} />
                  </span>
                  <span class="more-line">{o.oneLiner}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    <a class="next ticker" href={`/projects/${next.slug}/`} style="--ticker-speed:60s" aria-label={`Next case ${next.name}`}>
      <span class="ticker-track" aria-hidden="true">
        {
          [0, 1].map(() => (
            <span class="ticker-group">
              {[0, 1, 2].map(() => (
                <span class="next-item">
                  Next case <span class="next-name">{next.name}</span>
                  <Icon name="arrow" size={40} />
                </span>
              ))}
            </span>
          ))
        }
      </span>
    </a>
  </article>
</Base>

<style>
  .case {
    padding-top: 24px;
  }
  .crumbs {
    display: flex;
    gap: 10px;
    margin-bottom: 40px;
    color: var(--muted);
  }
  .crumbs [aria-current] {
    color: var(--ink);
  }
  .title {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  h1 {
    font-size: var(--step-display);
    letter-spacing: -0.035em;
    line-height: 0.95;
  }
  .title .lead {
    max-width: 30ch;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .tags {
    margin-top: 56px;
    padding-block: 18px;
    background: var(--field);
    color: var(--field-ink);
  }
  .tags li {
    display: flex;
    align-items: center;
    gap: 40px;
    padding-right: 40px;
    font-size: var(--step-lead);
    font-weight: 500;
    white-space: nowrap;
  }
  .tags li::after {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .cover {
    margin-top: 12px;
  }
  .cover-pic {
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--field);
  }
  .cover-pic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover,
  .shot {
    position: relative;
  }
  figcaption {
    position: absolute;
    right: 16px;
    top: 16px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--scrim);
    color: #f4f4f0;
  }
  .cover figcaption {
    right: calc(var(--m) + 16px);
  }

  .evidence {
    display: grid;
    gap: 32px;
    padding-block: calc(var(--section-gap) / 2);
  }
  .figures {
    display: grid;
    gap: 28px;
  }
  .figures li {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .value {
    font-size: var(--step-head);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .cmp {
    max-width: 640px;
    padding: clamp(24px, 4vw, 40px);
    background: var(--surface);
    border-radius: var(--radius);
  }

  .body {
    display: grid;
    gap: 40px;
  }
  .toc {
    display: none;
  }
  .content {
    display: grid;
    gap: calc(var(--section-gap) / 2);
    min-width: 0;
  }
  .block {
    display: grid;
    gap: 24px;
  }
  .block h2 {
    font-size: var(--step-head);
  }
  .built {
    display: grid;
    gap: 16px;
    padding-left: 1.4em;
    list-style: decimal;
  }
  .built li::marker {
    color: var(--accent);
    font-weight: 600;
  }
  .decisions {
    display: grid;
    gap: 16px;
  }
  .decisions li {
    position: relative;
    padding-left: 28px;
  }
  .decisions li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
  }
  .shot :global(img),
  .shot :global(video) {
    display: block;
    height: auto;
    width: 100%;
    border-radius: var(--radius);
  }

  .more {
    display: grid;
    gap: 32px;
    margin-top: var(--section-gap);
  }
  .more-list {
    display: grid;
    gap: 40px;
  }
  .more-item {
    display: grid;
    gap: 14px;
    text-decoration: none;
  }
  .more-pic {
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--field);
  }
  .more-pic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-soft);
  }
  .more-item:hover .more-pic :global(img) {
    transform: scale(1.04);
  }
  .more-name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--step-lead);
    font-weight: 600;
  }
  .more-name :global(svg) {
    transition: transform var(--t-hover) var(--ease-out);
  }
  .more-item:hover .more-name :global(svg) {
    transform: translateX(4px);
  }
  .more-line {
    max-width: 52ch;
  }
  @media (min-width: 768px) {
    .more-list {
      grid-template-columns: 1fr 1fr;
    }
  }
  .next {
    display: block;
    margin-top: var(--section-gap);
    padding-block: 32px;
    background: var(--field);
    color: var(--field-ink);
    text-decoration: none;
  }
  .next-item {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    padding-right: 72px;
    font-size: var(--step-head);
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .next-name {
    color: var(--accent);
  }
  .next:hover .ticker-track {
    animation-play-state: paused;
  }

  @media (min-width: 640px) {
    .figures {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .top {
      display: grid;
      grid-template-columns: 1fr;
    }
    .body {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: clamp(48px, 7vw, 120px);
    }
    .content {
      max-width: 820px;
    }
    .toc {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 32px);
      align-self: start;
    }
    .toc-title {
      font-weight: 600;
    }
    .toc ul {
      display: grid;
      gap: 4px;
      margin-top: 12px;
    }
    .toc a {
      display: block;
      padding: 6px 0;
      color: var(--muted);
      text-decoration: none;
      transition: color var(--t-hover) ease, transform 320ms var(--ease-out);
    }
    .toc a:hover,
    .toc a.on {
      color: var(--ink);
      transform: translateX(6px);
    }
    .toc a.on {
      font-weight: 600;
    }
  }
</style>

<script>
  // Mark the section being read in the table of contents.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((l) => l.classList.toggle('on', l.dataset.toc === e.target.id));
      });
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );
  links.forEach((l) => {
    const s = document.getElementById(l.dataset.toc!);
    if (s) io.observe(s);
  });
</script>

